# Optional. The desktop app stores its own settings and does not need this file.
# Copy to .env only if you want to pre-seed a headless start. Do not commit .env.

# Folder for pairing keys, logs, and the saved thermostat. Overrides the
# per-user default (see README).
# APRILAIRE_DATA_DIR=

# Used only when the app has not saved a thermostat yet.
# APRILAIRE_HOST=192.168.1.50
# APRILAIRE_PORT=8000

# HomeKit. Leave the pin blank to generate one on first launch.
# HOMEKIT_PIN=482-19-736
# HOMEKIT_PORT=51826
# HOMEKIT_NAME=AprilAire

# Local window / status page. Never expose this beyond this computer.
# APRILAIRE_UI_PORT=8765
